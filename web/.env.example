# Public contract address only. Never put wallet credentials here.
PACT_ENV_PROFILE=local
PACT_NETWORK=devnet
PACT_APP_ORIGIN=http://localhost:3007
PACT_AUTH_MODE=disabled
PACT_PROCESS_MODEL=stateless
PACT_SERVER_POLICY=disabled
# Server-only provider configuration. Never prefix a private endpoint NEXT_PUBLIC_.
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_RPC_FALLBACK_URL=https://another-reviewed-devnet-provider.invalid
NEXT_PUBLIC_PACT_SOLANA_PROGRAM_ID=
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Preserved Base fallback at /base.
NEXT_PUBLIC_PACT_CONTRACT_ADDRESS=
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
