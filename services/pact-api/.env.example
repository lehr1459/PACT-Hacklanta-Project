# Example only. Do not commit active environment files or secrets.
PACT_HOSTED_PROFILE=local
PACT_HOSTED_ORIGIN=http://localhost:3000
PACT_HOSTED_PROCESS_MODEL=single-persistent-process
PACT_HOSTED_HOST=127.0.0.1
PACT_HOSTED_PORT=4100
# Production PostgreSQL required in hosted mode; use externally supplied secret.
PACT_HOSTED_DATABASE_URL=
# At least 32 random bytes encoded base64url; supply out-of-band, never to browser.
PACT_HOSTED_PEPPER=
# Explicit local/test-only PGlite path; omit when using PostgreSQL.
PACT_HOSTED_LOCAL_DB=.local-db
# Server-only Devnet RPC; hosted mode requires explicit URL. Optional fallback.
SOLANA_RPC_URL=
SOLANA_RPC_FALLBACK_URL=
