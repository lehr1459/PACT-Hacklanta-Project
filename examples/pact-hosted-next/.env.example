# Copy to .env.local; enter the real server key privately, never in chat or source.
PACT_CONSUMER_ORIGIN=http://127.0.0.1:4011
PACT_API_BASE_URL=http://127.0.0.1:3000
PACT_APP_ID=REPLACE_WITH_PUBLIC_APP_ID
PACT_RESOURCE_KEY=premium-features
PACT_API_KEY=SET_PRIVATELY_IN_SERVER_ENVIRONMENT
# Register exact callback http://127.0.0.1:4011/api/login/callback in the PACT console.
# Never rename the key to NEXT_PUBLIC_*.
