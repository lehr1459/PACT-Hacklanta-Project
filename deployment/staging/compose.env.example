# NONSECRET template. Store the configured copy outside the checkout.
# Nothing is approved, provisioned or built by this template.
PACT_STAGING_DOMAIN=
PACT_PUBLIC_RPC_ORIGIN=
# Existing image identities, preloaded after owner-approved transfer/build.
# API/web may use sha256:<64hex> local image IDs; registry refs require @sha256.
PACT_API_IMAGE=
PACT_WEB_IMAGE=
# Absolute Linux paths. Do not put spaces, commas or symlink components in paths.
PACT_CONFIG_DIRECTORY=
PACT_PRIVATE_DIRECTORY=
PACT_PG_DATA=
PACT_CLOCK_DIRECTORY=
# Public full40hex reviewed commit; verification is performed before host actions.
PACT_SOURCE_REVISION=
